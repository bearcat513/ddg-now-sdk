# Single source of truth for local dev and Docker.
#   cp .env.example .env
# Bun auto-loads this file for `bun dev`; Compose reads it from the repo root,
# so `docker compose up` sees the same values.

# --- image versions (compose build args) ---
# PocketBase release: https://github.com/pocketbase/pocketbase/releases
PB_VERSION=0.40.4
# Bun base image tag for the app container
BUN_VERSION=1.4.0

# --- host ports (docker-compose.override.yml) ---
API_PORT=3000
# 8090 is PocketBase's own default and commonly taken by another local
# instance. `bun dev` outside Docker talks to this port.
PB_PORT=8091

# --- PocketBase superuser (the dashboard login) ---
# Created on PocketBase's first boot by docker/pb_hooks/setup/superuser.js.
# App accounts are ordinary users created through the app's own sign-up form —
# this one is only for http://localhost:8091/_/ and never reaches the app
# container. The password must be at least 8 characters; change both before
# deploying.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-please

# Set only when PocketBase is somewhere other than the published PB_PORT above.
# Compose sets it to http://pocketbase:8080 for the containerised app.
# POCKETBASE_URL=http://127.0.0.1:8091

# --- Telegram notifications (optional) ---
# A bot token here makes one bot available to every account on this server, so
# nobody has to make their own: they link a chat under Settings → Telegram
# notifications and that is the whole setup. Leave it unset and each account
# can still bring its own token, stored on its own record.
#
# Make one with @BotFather: /newbot, answer twice, and it hands you the token.
# It is not a DDG_SCRIPT_* variable, so an enum choice script cannot read it.
# TELEGRAM_BOT_TOKEN=123456789:AA...

# --- for enum choice scripts ---
# Only variables named DDG_SCRIPT_* are visible to a field's choice script as
# `env`; nothing else in this file is. Put API tokens a snippet needs here.
# DDG_SCRIPT_API_TOKEN=...
