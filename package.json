{
  "name": "ddg-now-sdk",
  "version": "0.0.1",
  "description": "Dummy Data Generator — schema inference and seeded data generation, as a ServiceNow scoped application.",
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#now:*": "./@types/servicenow/fluent/*/index.js"
  },
  "scripts": {
    "build": "now-sdk build",
    "deploy": "now-sdk install",
    "dev": "now-sdk run dev",
    "transform": "now-sdk transform",
    "types": "now-sdk dependencies",
    "typecheck": "tsc -p src/server/tsconfig.json --noEmit && tsc -p src/client/tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --import ./tools/register.mjs --test tests/*.test.ts",
    "codegen": "node --experimental-strip-types --import ./tools/register.mjs tools/codegen.mjs",
    "locale-data": "node tools/build-locale-data.mjs"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@servicenow/glide": "27.0.5",
    "@servicenow/isomorphic-rollup": "^1.3.7",
    "@servicenow/sdk": "4.11.2",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^3.7.0"
  }
}
