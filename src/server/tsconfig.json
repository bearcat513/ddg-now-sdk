{
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "../../dist/server",
        "module": "es2022",
        "target": "es2022",
        "lib": ["ES2022"],
        "moduleResolution": "bundler",
        "allowJs": true,
        "declaration": false,
        "sourceMap": false,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,

        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["./**/*.ts", "../../@types/**/*.modules.d.ts"],
    "exclude": ["**/*.now.ts"]
}
